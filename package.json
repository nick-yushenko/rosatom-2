{
	"name": "rosatom-2",
	"version": "1.0.0",
	"description": "Express 5 TypeScript application skeleton",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc && tsc-alias",
		"start": "node dist/server.js",
		"test": "node --test --import tsx test/**/*.test.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"keywords": [
		"express",
		"typescript",
		"api"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^5.0.1",
		"helmet": "^8.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.2",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"supertest": "^7.0.0",
		"tsc-alias": "^1.8.10",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.1"
	},
	"engines": {
		"node": ">=20"
	}
}
